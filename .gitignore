__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
htmlcov/
.venv/
build/
dist/

# Live corpora, review projects, operator configuration, and credentials never
# belong in the public source tree.  Deliberate synthetic fixtures live under
# tests/fixtures instead.
/reviews/*
!/reviews/.gitkeep
# The AI_NCM_Review review project is tracked on the ai-ncm-review branch only;
# master stays a clean template. Review branches never merge back.
!/reviews/AI_NCM_Review/
/external/*
!/external/MyLib
/local-corpora/
/state/
/configs/libraries/*.toml
!/configs/libraries/mylib.toml
/work/
/output/
/.vibereview-private/
*.secret
**/state/generations/*/auxiliary/library/
